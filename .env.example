# === Database ===
# Dev: local PostgreSQL (TablePlus)
DATABASE_URL=postgresql://user:pass@localhost:5432/movierecsys
# Staging/Demo: Neon (uncomment khi migrate)
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/movierecsys?sslmode=require

# === Qdrant Cloud ===
QDRANT_URL=https://xxx.qdrant.io
QDRANT_API_KEY=your_key_here
QDRANT_COLLECTION_TFIDF=movies_tfidf
QDRANT_COLLECTION_EMBEDDING=movies_embedding
QDRANT_COLLECTION_EMOTION=movies_emotion

# === Google Gemini ===
GEMINI_API_KEY=your_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# === TMDB ===
TMDB_API_KEY=your_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# === App ===
APP_ENV=development
COLD_START_THRESHOLD=5
DEFAULT_TOP_K=10
TMDB_CACHE_TTL_SECONDS=86400
